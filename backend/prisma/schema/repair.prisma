model Repair {
    repairID       Int       @id @default(autoincrement())
    repairCode     String    @unique
    customerID     Int
    vehicleID      Int
    jobID          Int
    currentMileage Int
    mechanicID     Int
    total          Int       @default(0)
    status         StatusP   @default(ACT)
    createdAt      DateTime  @default(now())
    updatedAt      DateTime?
}
