model Repair {
    repairID       Int       @id @default(autoincrement())
    repairCode     String    @unique
    customerID     Int
    vehicleID      Int
    jobID          Int
    currentMileage Int
    mechanicID     Int
    total          Int       @default(0)
    status         StatusP   @default(ACT)
    createdAt      DateTime  @default(now())
    updatedAt      DateTime?

    attachments    RepairAttachment[]
}

model RepairAttachment {
    repairID Int
    fileID    Int
    reference String
    status    StatusP @default(ACT)
    createdAt DateTime @default(now())
    updatedAt DateTime?

    Repair   Repair @relation(fields: [repairID], references: [repairID])

    @@id([repairID, fileID, reference])
}
