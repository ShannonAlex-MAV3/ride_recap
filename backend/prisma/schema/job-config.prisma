model JobConfig {
  jobID       Int            @id @default(autoincrement())
  jobCode     String         @unique
  jobName     String
  description String
  category    JobCategoriesP
  status      StatusP        @default(ACT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime?
}

enum StatusP {
  ACT
  INA
}

enum JobCategoriesP {
  GM
  ID
  ER
  BS
  TS
  AC
  BP
  TW
}
