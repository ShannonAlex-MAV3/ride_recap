# Application Configuration
NODE_ENV=production
PORT=8080

# External Cloud Database (Aiven PostgreSQL)
# Replace with your actual cloud database connection string
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Filebase S3 Configuration
FILEBASE_ACCESS_KEY=your_access_key_here
FILEBASE_SECRET_KEY=your_secret_key_here
FILEBASE_ENDPOINT=https://s3.filebase.com
FILEBASE_REGION=us-east-1
FILEBASE_BUCKET_NAME=your-bucket-name

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Your-App <noreply@yourdomain.com>

# Frontend API URL
# For development: http://localhost:8080
# For production: your production backend URL
VITE_API_URL=http://localhost:8080
