model AutoCare {
    autoCareID     Int       @id @default(autoincrement())
    autoCareCode   String    @unique
    customerID     Int
    vehicleID      Int
    jobID          Int
    currentMileage Int
    metricConfig   Json
    mechanic       String
    status         StatusP   @default(ACT)
    createdAt      DateTime  @default(now())
    updatedAt      DateTime?
}
