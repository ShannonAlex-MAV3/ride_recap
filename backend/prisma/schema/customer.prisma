model Customer {
  customerID   Int       @id @default(autoincrement())
  customerCode String    @unique
  firstName    String
  lastName     String
  email        String    @unique
  phone        String
  address      String
  status       StatusP   @default(ACT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime?
  vehicles     Vehicle[]
}

model Vehicle {
  vehicleID    Int       @id @default(autoincrement())
  licensePlate String    @unique
  make         String
  model        String
  year         Int
  color        String
  status       StatusP   @default(ACT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime?
  customerID   Int
  customer     Customer  @relation(fields: [customerID], references: [customerID])
}
